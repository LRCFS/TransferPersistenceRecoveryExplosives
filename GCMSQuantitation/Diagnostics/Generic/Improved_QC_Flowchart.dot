digraph GCMS_QC_Flow {
  rankdir=TB;
  fontname="Helvetica";
  fontsize=20;
  labelloc="t";
  label="GC-MS PETN/RDX Injection & Sample Acceptance Flowchart (Revised v3)\nSTATUS: IMPLEMENTED -- describes the CURRENT live pipeline (Code/InjectionAcceptance.R).\nFull audit against the live code completed 2026-09-08: Sections A-D are all implemented; Section A and C3 corrected\nto show the blank evaluation's actual 3-tier Contaminated/Trace-detected/Clean classification (previously\nunder-diagrammed as binary); stale 'not yet implemented'/'DESIGN CHANGE' notes referencing a since-removed\ncompute_analysis_accepted() function corrected to reflect current, live behaviour (see legend notes).";
  bgcolor="white";
  nodesep=0.35;
  ranksep=0.55;
  splines=true;
  node [fontname="Helvetica", fontsize=11, style="filled,rounded", shape=box, margin="0.15,0.08"];
  edge [fontname="Helvetica", fontsize=9.5];

  // ---------- COLOUR KEY ----------
  // green   #d1e7dd / #0f5132  = PASS / accepted outcome
  // amber   #fff3cd / #664d03  = WARN / qualitative flag / reduced confidence / flagged design change
  // red     #f8d7da / #842029  = FAIL / reanalysis required
  // blue    #cfe2ff / #084298  = decision point
  // purple  #e2d9f3 / #432874  = routing node (recalls an earlier answer, not a new decision)
  // grey    #e2e3e5 / #41464b  = register / log (informational, read by later checks)

  START [label="Run GC-MS Sequence", shape=ellipse, fillcolor="#41464b", fontcolor=white];

  //////////////////////////////////////////////////////////////////
  subgraph cluster_A {
    label="SECTION A -- Blank Injection Evaluation  (run for every blank)";
    style="filled"; color="#adb5bd"; fillcolor="#f8f9fa"; fontsize=13; fontcolor="#212529";

    A0 [label="Analyse blank injection\n(same peak-detection pipeline as samples)"];
    A1 [label="PETN/RDX SNR tier?\n(worse of the two analytes' own tiers,\nsame Quantifiable/Trace/Negative\nclassification as everywhere else --\nSNR≥10 / 3≤SNR<10 / SNR<3)", shape=diamond, fillcolor="#cfe2ff", fontcolor="#084298"];
    A2 [label="Any other significant peak?\n(height above clean-blank baseline)", shape=diamond, fillcolor="#cfe2ff", fontcolor="#084298"];
    A_CONTAM [label="BLANK CONTAMINATED\n(either analyte Quantifiable, SNR≥10)\nInvestigate carryover source.\nHard-fails any Sample/QC/NC peak this\nblank brackets (Section C, C3).", fillcolor="#f8d7da", fontcolor="#842029"];
    A_TRACE [label="BLANK TRACE DETECTED\n(either analyte Trace, 3≤SNR<10,\nneither Quantifiable)\nDoes NOT hard-fail a bracketed peak --\ncontributes a WARNING caveat only\n(Section C, C3).", fillcolor="#fff3cd", fontcolor="#664d03"];
    A_OTHER [label="NON-TARGET PEAK PRESENT\nInstrument-performance risk only --\ndoes NOT set a carryover-risk flag\n(no PETN/RDX signal was seen, so there\nis nothing to carry over).", fillcolor="#fff3cd", fontcolor="#664d03"];
    A_PASS [label="BLANK CLEAN -- PASS\nNo carryover-risk flag set.", fillcolor="#d1e7dd", fontcolor="#0f5132"];
    INSTR_LOG [label="Instrument-Performance Log\n(trend-only; does NOT gate anything\ndownstream -- separate from the\ncarryover-risk register below)", shape=note, fillcolor="#e2e3e5", fontcolor="#41464b", fontsize=9.5];

    A0 -> A1;
    A1 -> A_CONTAM [label="Quantifiable\n(either analyte)"];
    A1 -> A_TRACE [label="Trace\n(either analyte,\nneither Quantifiable)"];
    A1 -> A2 [label="Negative\n(both analytes)"];
    A2 -> A_OTHER [label="Yes"];
    A2 -> A_PASS [label="No"];
    A_OTHER -> INSTR_LOG;
  }

  BLANK_REG [label="Blank Carryover-Risk Register\n(per blank: Clean / Trace detected / Contaminated --\nUPDATED 2026-09-08: this register already stored all\nthree values, but this chart previously only diagrammed\ntwo; Section C's bracket check now shows all three, see\nC3).\nA non-target peak (A_OTHER) is instrument-performance\ninformation only and counts as CLEAN for this register\n(does not upgrade a Clean blank to Trace/Contaminated).\nRead by the bracketing-blank check in Section C.", shape=cylinder, fillcolor="#e2e3e5", fontcolor="#41464b", fontsize=10.5];

  START -> A0;
  A_CONTAM -> BLANK_REG;
  A_TRACE -> BLANK_REG;
  A_PASS -> BLANK_REG;
  A_OTHER -> BLANK_REG [style=dashed, color="#adb5bd", label="counts as clean"];

  //////////////////////////////////////////////////////////////////
  subgraph cluster_B {
    label="SECTION B -- QC Evaluation  (both PETN & RDX; each level bracketed pre- & post- sample block)";
    style="filled"; color="#adb5bd"; fillcolor="#f8f9fa"; fontsize=13; fontcolor="#212529";

    B0 [label="Analyse QC injections"];
    B_INJCHECK [label="Did THIS QC injection itself\nsucceed? (IS detected &\nPA ≥ minimum criteria)", shape=diamond, fillcolor="#cfe2ff", fontcolor="#084298"];
    B_HASMORE [label="Is a further QC of the SAME\nlevel & analyte available,\none position further from\nthe sample block?", shape=diamond, fillcolor="#cfe2ff", fontcolor="#084298"];
    B_SUBSTITUTE [label="FALLBACK: substitute that\nfurther QC for this bracket\nposition (re-check its own\ninjection validity in turn)"];
    B_NOSUB [label="No usable substitute in that\ndirection -- this bracket\nposition counts as MISSING", fillcolor="#f8d7da", fontcolor="#842029"];
    B1 [label="QC concentration level?", shape=diamond, fillcolor="#cfe2ff", fontcolor="#084298"];

    B2_SPLIT [label="0.2ng QC -- evaluated as TWO\nINDEPENDENT flags from the SAME\ninjection (added 2026-09-08, see NOTE3C):\nDETECTABILITY (SNR only) and\nQUANTIFICATION (SNR AND concentration>0)", shape=hexagon, fillcolor="#e2d9f3", fontcolor="#432874"];

    B2D [label="DETECTABILITY --\nSNR ≥ 3 (LOD)?", shape=diamond, fillcolor="#cfe2ff", fontcolor="#084298"];
    B2Db [label="SNR ≥ 10 also?\n(WARN tier -- applied uniformly to\nBOTH PETN and RDX)", shape=diamond, fillcolor="#cfe2ff", fontcolor="#084298"];
    B_DET_FAIL [label="DETECTABILITY CHECK FAIL\nSystem LOD not met at this bracket.", fillcolor="#f8d7da", fontcolor="#842029"];
    B_DET_WARN [label="DETECTABILITY CHECK WARN\n(3 ≤ SNR < 10)\nBracket usable; marginal sensitivity noted.", fillcolor="#fff3cd", fontcolor="#664d03"];
    B_DET_PASS [label="DETECTABILITY CHECK PASS", fillcolor="#d1e7dd", fontcolor="#0f5132"];

    B2Q [label="QUANTIFICATION --\nConcentration > 0?\n(does the fitted calibration curve\nresolve a positive value for this\ndrift-corrected response? A real,\ndetectable peak can still floor to\nexactly 0 here -- a curve-fitting-\nintercept artefact, not a non-detect;\nsee NOTE3C)", shape=diamond, fillcolor="#cfe2ff", fontcolor="#084298"];
    B2Qb [label="SNR ≥ 3 (LOD)?", shape=diamond, fillcolor="#cfe2ff", fontcolor="#084298"];
    B2Qc [label="SNR ≥ 10 also?\n(WARN tier)", shape=diamond, fillcolor="#cfe2ff", fontcolor="#084298"];
    B_QUANTFLAG_FAIL [label="QUANTIFICATION CHECK FAIL\n(concentration ≤ 0, OR SNR < 3)", fillcolor="#f8d7da", fontcolor="#842029"];
    B_QUANTFLAG_WARN [label="QUANTIFICATION CHECK WARN\n(3 ≤ SNR < 10, concentration > 0)", fillcolor="#fff3cd", fontcolor="#664d03"];
    B_QUANTFLAG_PASS [label="QUANTIFICATION CHECK PASS", fillcolor="#d1e7dd", fontcolor="#0f5132"];

    B3 [label="Quantitative bias\nwithin ±20%?", shape=diamond, fillcolor="#cfe2ff", fontcolor="#084298"];
    B_QUANT_PASS [label="6ng QUANTITATION\nCHECK PASS", fillcolor="#d1e7dd", fontcolor="#0f5132"];
    B_QUANT_FAIL [label="6ng QUANTITATION CHECK FAIL\nAny quantified-positive result relying on\nthis bracket must be reanalysed.", fillcolor="#f8d7da", fontcolor="#842029"];

    B0 -> B_INJCHECK;
    B_INJCHECK -> B1 [label="Yes, injected OK"];
    B_INJCHECK -> B_HASMORE [label="No (this QC\ndid not inject)"];
    B_HASMORE -> B_SUBSTITUTE [label="Yes"];
    B_HASMORE -> B_NOSUB [label="No"];
    B_SUBSTITUTE -> B_INJCHECK [label="re-check substitute"];
    B1 -> B2_SPLIT [label="0.2ng"];
    B1 -> B3 [label="6ng\n(quantitation check)"];
    B2_SPLIT -> B2D;
    B2_SPLIT -> B2Q;
    B2D -> B_DET_FAIL [label="No"];
    B2D -> B2Db [label="Yes"];
    B2Db -> B_DET_WARN [label="No"];
    B2Db -> B_DET_PASS [label="Yes"];
    B2Q -> B_QUANTFLAG_FAIL [label="No (conc ≤ 0)"];
    B2Q -> B2Qb [label="Yes (conc > 0)"];
    B2Qb -> B_QUANTFLAG_FAIL [label="No (SNR < 3)"];
    B2Qb -> B2Qc [label="Yes"];
    B2Qc -> B_QUANTFLAG_WARN [label="No"];
    B2Qc -> B_QUANTFLAG_PASS [label="Yes"];
    B3 -> B_QUANT_PASS [label="Yes"];
    B3 -> B_QUANT_FAIL [label="No"];
  }

  QC_REG [label="QC Bracket Status Register (per analyte, per level)\nEvaluated at BOTH the pre- and post- QC injection\n(after the injection-fallback substitution above).\n0.2ng now stores TWO independent bracket verdicts per\nanalyte from the SAME injection -- DETECTABILITY (read\nby Negative Control rows) and QUANTIFICATION (read by\nreal Sample rows); see Section C, C_ROWTYPE:\n• Combined = PASS only if pre AND post are BOTH present\n   AND BOTH PASS (for whichever register applies)\n• Combined = WARN only if BOTH present and at least one\n   is WARN (0.2ng only -- 6ng has no WARN tier)\n• Combined = FAIL if EITHER side is MISSING (incl. an\n   injection failure with no usable substitute) or FAILED\n   -- both sides are REQUIRED, for either register", shape=cylinder, fillcolor="#e2e3e5", fontcolor="#41464b", fontsize=10.5];

  BLANK_REG -> B0 [label="sequence continues"];
  B_NOSUB -> QC_REG;
  B_DET_FAIL -> QC_REG; B_DET_WARN -> QC_REG; B_DET_PASS -> QC_REG;
  B_QUANTFLAG_FAIL -> QC_REG; B_QUANTFLAG_WARN -> QC_REG; B_QUANTFLAG_PASS -> QC_REG;
  B_QUANT_PASS -> QC_REG; B_QUANT_FAIL -> QC_REG;

  //////////////////////////////////////////////////////////////////
  subgraph cluster_C {
    label="SECTION C -- Per-Analyte Evaluation (run INDEPENDENTLY for PETN and for RDX; NCs run the IDENTICAL tree EXCEPT at the 0.2ng bracket check -- see C_ROWTYPE, NOTE7)";
    style="filled"; color="#adb5bd"; fillcolor="#f8f9fa"; fontsize=13; fontcolor="#212529";

    C0 [label="Analyse sample/NC injection"];
    C1 [label="Internal Standard (IS) detected\n& PA ≥ minimum criteria (1000)?", shape=diamond, fillcolor="#cfe2ff", fontcolor="#084298"];
    C_NOINJECT [label="ROW = FAIL: Injection failure\nOutcome = Reanalyse\nSHORT-CIRCUIT EXIT -- stops here immediately.\nNeither analyte's peaks nor Section D are\nevaluated at all for this row (first-failure-\nonly policy applies from the very first check).", fillcolor="#f8d7da", fontcolor="#842029"];
    C_ISLOW [label="ROW = FAIL: IS abnormally low (PA=x)\nOutcome = Reanalyse\nSHORT-CIRCUIT EXIT -- stops here immediately,\nidentical treatment to Not detected (C_NOINJECT).\n[Fixed 2026-08-11: previously a WARNING caveat\nthat continued to C2 -- an abnormally low IS\ndenominator can inflate an IS-ratio-quantified\nanalyte's (RDX, or PETN when IS-ratio mode is\nused) reported concentration/recovery to\nphysically impossible values (e.g. observed\nRDX recovery = 164.8%). No override exists.]", fillcolor="#f8d7da", fontcolor="#842029"];

    C2 [label="FOR EACH ANALYTE (PETN, RDX)\nindependently, starting here:\nIs a peak present?\n(height ≥ minimum criteria)", shape=diamond, fillcolor="#cfe2ff", fontcolor="#084298"];

    C3 [label="Bracketing blank status for\nTHIS analyte? (worse of pre/post;\nmissing on one side treated leniently\nas Clean on that side, NOT a fail --\nunlike QC brackets, Section B)", shape=diamond, fillcolor="#cfe2ff", fontcolor="#084298"];
    C_CARRYOVER [label="PEAK MAY BE DUE TO CARRYOVER\n(bracketing blank Contaminated)\nCannot distinguish from genuine\ndetection -- reanalysis required.", fillcolor="#f8d7da", fontcolor="#842029"];
    C_BLANKCAVEAT [label="CAVEAT NOTED\n(bracketing blank Trace detected --\nnot enough to hard-fail, but noted)\nContributes to row-level PASS* in Section D.", fillcolor="#fff3cd", fontcolor="#664d03"];

    C4 [label="Peak SNR classification\nfor THIS analyte?", shape=diamond, fillcolor="#cfe2ff", fontcolor="#084298"];

    C4b [label="[Quantifiable tier ONLY, added 2026-08-12]\nAre this analyte's designated\nconfirmatory ion(s) ALSO detected\n(SNR ≥ 3) at the same RT?\nPETN: m/z76 only. RDX: m/z46 AND m/z75.\n(Not checked at Trace/Negative tier --\nqualifier signal too weak to be meaningful\nthere. Skipped, not failed, if the qualifier\ncolumns don't exist in the data at all.)", shape=diamond, fillcolor="#cfe2ff", fontcolor="#084298"];
    C_NOCONFIRM [label="CONFIRMATORY ION NOT DETECTED\nIdentity not confirmed -- a peak at the right\nSNR/RT alone is insufficient; independent\nfragment-ion evidence is required for a\nQuantifiable-tier call. Reanalysis required.\n[m/z57 deliberately excluded as a PETN\nqualifier -- only 18.2% of pure Cal standards\never reach a measurable SNR for it; requiring\nit would fail ~70-100% of genuine detections.\nA ratio-based check was also rejected -- RDX's\nqualifier/quantifier ratio showed real,\nsignificant concentration-dependence\n(r=-0.72/-0.69, p<1e-10), so a fixed\nratio+tolerance would not be valid across\nthe calibration range.]", fillcolor="#f8d7da", fontcolor="#842029"];

    C6 [label="[Quantifiable tier ONLY]\nDo bracketing 6ng QCs\n(pre & post, BOTH required)\npass? (reads QC Bracket Register)", shape=diamond, fillcolor="#cfe2ff", fontcolor="#084298"];
    C_6FAIL [label="6ng QC BRACKET FAILED OR UNAVAILABLE\nQuantitation accuracy not confirmed for this\npositive result -- reanalysis required.\nOnly checked when this analyte is Quantifiable;\nno override exists.", fillcolor="#f8d7da", fontcolor="#842029"];

    C_ROWTYPE [label="Is this row a real Sample\nor a Negative Control (NC)?\n(added 2026-09-08 -- the ONE point where\nSamples and NCs now diverge structurally;\nsee NOTE7)", shape=diamond, fillcolor="#cfe2ff", fontcolor="#084298"];
    C7 [label="[Trace or Negative tier ONLY]\nDo bracketing 0.2ng QCs\n(pre & post, BOTH required) pass?\nSample -> reads QUANTIFICATION register.\nNC -> reads DETECTABILITY register.\n(Section B, B2_SPLIT)", shape=diamond, fillcolor="#cfe2ff", fontcolor="#084298"];
    C_02FAIL [label="0.2ng QC BRACKET FAILED OR UNAVAILABLE\nSystem LOD (NC) or quantifiability (Sample) not\nconfirmed adequate at the time of this result --\nreanalysis required. No override, for samples OR\nNCs, against whichever register applies: a missing/\nfailed bracket always hard-fails here.", fillcolor="#f8d7da", fontcolor="#842029"];
    C_CAVEAT [label="CAVEAT NOTED\n(0.2ng bracket WARN -- both sides present,\nmarginal but usable)\nContributes to row-level PASS* in Section D.", fillcolor="#fff3cd", fontcolor="#664d03"];

    C_ROUTE [label="Route by THIS analyte's SNR tier\n(determined earlier at the peak-present /\nSNR-classification steps above, carried\nforward unchanged by the bracket checks)", shape=hexagon, fillcolor="#e2d9f3", fontcolor="#432874"];
    C_QUANTIFIED [label="ANALYTE DETECTED AND QUANTIFIED\n(append caveat if flagged above)", fillcolor="#d1e7dd", fontcolor="#0f5132"];
    C_TRACE [label="TRACE ANALYTE DETECTED\nBelow quantitation level -- reported as a\nqualitative positive, not a numeric value.\nGENUINE outcome (not forced to FAIL), but ALWAYS\ncontributes a WARNING caveat to Section D --\neven if brackets were clean -- since it is\ninherently a below-quantitation call.", fillcolor="#fff3cd", fontcolor="#664d03"];
    C_NEGATIVE [label="ANALYTE NEGATIVE\nNo peak / below LOD, AND system LOD\nconfirmed adequate via 0.2ng bracket.", fillcolor="#d1e7dd", fontcolor="#0f5132"];

    C0 -> C1;
    C1 -> C_NOINJECT [label="Not detected"];
    C1 -> C_ISLOW [label="Detected, low"];
    C1 -> C2 [label="OK"];

    C2 -> C_ROWTYPE [label="No peak\n(tier = Negative,\npending LOD confirmation)"];
    C2 -> C3 [label="Yes, peak\npresent"];

    C3 -> C_CARRYOVER [label="Contaminated"];
    C3 -> C_BLANKCAVEAT [label="Trace detected"];
    C3 -> C4 [label="Clean"];
    C_BLANKCAVEAT -> C4;

    C4 -> C4b [label="SNR ≥ 10\n(tier = Quantifiable /\n\"positive\" -> 6ng only)"];
    C4 -> C_ROWTYPE [label="3 ≤ SNR < 10\n(tier = Trace -> 0.2ng only)"];
    C4 -> C_ROWTYPE [label="SNR < 3\n(tier = Negative, pending\nLOD confirmation -> 0.2ng only)"];

    C4b -> C_NOCONFIRM [label="No"];
    C4b -> C6 [label="Yes\n(or check not applicable --\nqualifier columns absent)"];

    C6 -> C_6FAIL [label="No"];
    C6 -> C_ROUTE [label="Yes"];

    C_ROWTYPE -> C7 [label="Sample or NC\n(routes which register C7 reads)"];
    C7 -> C_ROUTE [label="PASS (both sides)"];
    C7 -> C_CAVEAT [label="WARN (both present,\nneither missing/FAIL)"];
    C7 -> C_02FAIL [label="Missing or FAIL\n(either side) -- no override"];

    C_CAVEAT -> C_ROUTE;

    C_ROUTE -> C_QUANTIFIED [label="Quantifiable"];
    C_ROUTE -> C_TRACE [label="Trace"];
    C_ROUTE -> C_NEGATIVE [label="Negative"];
  }

  QC_REG -> C0 [label="sequence continues"];
  BLANK_REG -> C3 [style=dashed, color="#41464b", constraint=false, label="reads register"];
  QC_REG -> C6 [style=dashed, color="#41464b", constraint=false, label="reads register\n(6ng)"];
  QC_REG -> C7 [style=dashed, color="#41464b", constraint=false, label="reads register\n(0.2ng detect OR quant,\nper C_ROWTYPE)"];

  //////////////////////////////////////////////////////////////////
  subgraph cluster_D {
    label="SECTION D -- Combine Per-Analyte Results into ONE Row-Level Outcome (FIRST-FAILURE-ONLY policy, fixed check order: IS -> PETN -> RDX)";
    style="filled"; color="#adb5bd"; fillcolor="#f8f9fa"; fontsize=13; fontcolor="#212529";

    D0 [label="Collect this row's results:\nPETN's Section C outcome +\nRDX's Section C outcome\n(only reached if IS passed C1 --\nan injection failure never gets here)"];
    D2 [label="Did PETN's Section C path end in\na FAIL-class terminal (carryover /\nconfirmatory-ion-not-detected /\n6ng-fail / 0.2ng-fail)?", shape=diamond, fillcolor="#cfe2ff", fontcolor="#084298"];
    D_FAIL_PETN [label="ROW = FAIL: <PETN's specific reason>\nOutcome = Reanalyse\n(RDX's result is not reported --\nfirst-failure-only policy)", fillcolor="#f8d7da", fontcolor="#842029"];

    D3 [label="Did RDX's Section C path end in\na FAIL-class terminal?", shape=diamond, fillcolor="#cfe2ff", fontcolor="#084298"];
    D_FAIL_RDX [label="ROW = FAIL: <RDX's specific reason>\nOutcome = Reanalyse", fillcolor="#f8d7da", fontcolor="#842029"];

    D4 [label="Does either analyte carry a WARNING\ncaveat -- bracketing blank Trace detected\n(C3), 0.2ng bracket WARN (C7), OR either\nanalyte's tier is Trace (always a caveat,\neven if every bracket was clean)?", shape=diamond, fillcolor="#cfe2ff", fontcolor="#084298"];
    D_PASSSTAR [label="ROW = PASS*\nOutcome = Complete\n(both analytes' Quantified/Trace/Negative\nresults are reported, with caveat noted --\nincluding: any analyte reported as Trace\nalways lands here, never as a plain PASS)", fillcolor="#fff3cd", fontcolor="#664d03"];
    D_PASS [label="ROW = PASS\nOutcome = Complete\n(both analytes' results reported cleanly)", fillcolor="#d1e7dd", fontcolor="#0f5132"];

    D0 -> D2;
    D2 -> D_FAIL_PETN [label="Yes"];
    D2 -> D3 [label="No"];
    D3 -> D_FAIL_RDX [label="Yes"];
    D3 -> D4 [label="No"];
    D4 -> D_PASSSTAR [label="Yes"];
    D4 -> D_PASS [label="No"];
  }

  C_CARRYOVER -> D0;
  C_NOCONFIRM -> D0;
  C_6FAIL -> D0;
  C_02FAIL -> D0;
  C_QUANTIFIED -> D0;
  C_TRACE -> D0;
  C_NEGATIVE -> D0;

  //////////////////////////////////////////////////////////////////
  subgraph cluster_L {
    label="Legend & Notes";
    style="filled"; color="#adb5bd"; fillcolor="#ffffff"; fontsize=13; fontcolor="#212529";
    node [shape=note, fillcolor="#ffffff", fontsize=9.5, style="filled"];

    KEY [label="Colour key:\nGreen = PASS / accepted outcome\nAmber = WARN / qualitative flag / flagged design change\nRed = FAIL / reanalysis required\nBlue = decision point\nPurple hexagon = routing node (recalls an earlier\n  answer, not a new decision)\nGrey cylinder = register (informational, read by\n  later checks)"];
    NOTE1 [label="Every decision node shows BOTH outcomes\nexplicitly (no implicit 'pass' branch)."];
    NOTE2 [label="Carryover (bracketing-blank) check applies to\nANY detected peak, not only quantifiable ones --\na 'trace' result can also be carryover."];
    NOTE3 [label="Bracket checks are now CONDITIONAL on tier, not\nuniversal: 6ng (accuracy) is only checked when this\nanalyte is Quantifiable ('positive'); 0.2ng (LOD) is\nonly checked when this analyte is Trace or Negative.\nA missing pre- or post- QC counts as FAIL, not WARN\n(both required) -- UNLESS a same-level/analyte QC\nfurther from the sample block can be substituted for\nan injection-failed bracket QC (Section B fallback)."];
    NOTE3B [label="CONFIRMED DESIGN DECISION: there is NO override at\neither bracket gate, for samples or NCs -- a missing/\nfailed bracket is always a hard FAIL, whichever\nregister it is checked against. UPDATED 2026-09-08:\nthe 6ng gate remains identical for samples and NCs\n(one register, one check). The 0.2ng gate now checks\nTWO different registers depending on row type (see\nNOTE3C, NOTE7) -- Samples and NCs no longer necessarily\nsee the SAME verdict from the SAME underlying QC\ninjection at 0.2ng, even though neither ever gets an\nescape-hatch override."];
    NOTE3C [label="0.2ng split into DETECTABILITY vs QUANTIFICATION\n(added 2026-09-08): a real, detected peak's fitted\nconcentration can floor to exactly 0 even at good SNR --\nthe fitted calibration curve's own y-intercept (an\nartefact of a weighted quadratic fit through a handful\nof real standards, not a physical measurement) can sit\nABOVE a genuine low-level response, so no concentration\n>=0 on that curve reproduces it. This is a curve-fitting\nartefact, not evidence of a non-detect -- confirmed via\ndirect comparison against the raw response and against\nan identical, independently-documented RDX/Analysis1\ncalibration-floor case. DECISION: a Sample's own reported\nrecovery % still needs a real number, so Samples keep the\nstricter QUANTIFICATION flag (SNR AND concentration>0)\nunchanged from the pre-2026-09-08 behaviour. A Negative\nControl's contamination verdict only ever needs 'was\nsomething detected', so NCs use the new DETECTABILITY\nflag (SNR only) instead -- a real detection no longer\ngets silently reclassified as 'Not evaluated' purely\nbecause of where the calibration curve happens to\nintercept zero."];
    NOTE4 [label="PETN/RDX asymmetry -- justified vs. removed:\nKEPT (grounded in chemistry/instrumentation):\n IS-ratio quantification for RDX only (15N-RDX is\n not a valid drift proxy for PETN -- tested and\n rejected); drift correction for PETN only;\n noise-window position; per-analyte height/SNR\n floors.\nREMOVED (was an incidental implementation gap,\nnot a scientific requirement): the 0.2ng\nsensitivity WARN tier is now identical for both\nanalytes (Section B)."];
    NOTE5 [label="Row-level outcome (Section D) uses a FIXED,\nagreed check order -- IS, then PETN, then RDX --\nand reports ONLY the first blocking failure found.\nThe IS check short-circuits immediately at C1 (see\nC_NOINJECT / C_ISLOW -- BOTH IS outcomes are hard\nFAILs as of 2026-08-11) -- it does NOT wait for\nSection D; only PETN-vs-RDX ordering is resolved\nthere, since IS already gates entry to the\nper-analyte loop."];
    NOTE6 [label="CONFIRMED DESIGN DECISION, LIVE SINCE 2026-08-10\n(the InjectionAcceptance.R consolidation --\nsee CONTEXT.md): a bracket-confirmed trace-level\ndetection is a genuine, reportable outcome, not an\nautomatic reanalysis trigger. A Trace result ALWAYS\ncarries a WARNING caveat forward (Section D, D4) --\nif every other check passes, the row is PASS*, never\na plain PASS, reflecting the reduced confidence of an\nunquantified detection. [Historical note: this was a\ndeliberate departure from an OLDER, now-retired\ncompute_analysis_accepted() implementation, which\nauto-FAILed any detected-but-not-Quantifiable peak --\nthat function no longer exists in the codebase.]"];
    NOTE7 [label="UPDATED 2026-09-08: Negative Controls (NCs) and Samples\nrun the IDENTICAL tree EXCEPT for exactly ONE point --\nthe 0.2ng bracket check (Section C, C_ROWTYPE/C7): a\nSample reads the QUANTIFICATION register, an NC reads\nthe DETECTABILITY register (Section B, NOTE3C). This is\na deliberate, narrow divergence, not a return to the old\nasymmetric design -- both row types still go through the\nidentical carryover check, confirmatory-ion check, 6ng\nbracket, and Section D combination logic; only WHICH\n0.2ng verdict is consulted differs, and only because a\ncontamination check and a quantified-recovery check are\ngenuinely different questions with different evidence\nrequirements. NCs and samples otherwise still diverge\nonly in reporting-label vocabulary at the very end (e.g.\n'Negative (clean)', 'Positive: trace detected' map onto\nC_NEGATIVE/C_TRACE/C_QUANTIFIED at reporting time; not\nseparately diagrammed here)."];
    NOTE8 [label="Confirmatory ion check (C4b, added 2026-08-12):\nderived empirically from all 11 'Accepted Analysis'\ndatasets (Cal standards + real Sample/QC data).\nPETN's second monitored ion (m/z57) was tested and\nREJECTED as a confirmatory requirement -- only 18.2%\nof pure Cal standards ever reach a measurable SNR for\nit, so requiring it would fail most genuine detections,\nnot catch misidentifications. m/z76 alone is used.\nRDX requires BOTH its monitored ions (m/z46, m/z75) --\nboth are reliably detected (~100% in Cal standards) and\nrequiring both costs zero extra failures on any real\nSample/QC/Cal row in the study. A ratio-based check\n(qualifier/quantifier PA ratio) was also investigated\nand rejected: RDX's ratio showed real, significant\nconcentration-dependence (r=-0.72/-0.69, p<1e-10),\nso a single fixed ratio+tolerance would not be valid\nacross the calibration range -- a qualitative detection\ncheck (SNR ≥ 3) was used instead. A full-scan (m/z\n41-200) survey at PETN's RT found no better second\nqualifier candidate than the currently-monitored ions."];

    NOTE9 [label="Reanalysis selection (NOT diagrammed above -- a separate\nstage that runs AFTER this per-injection acceptance chart,\nonce multiple physical re-analyses of the same Sample/NC\nexist): as of 2026-09-08, select_best_attempt() prefers the\naccepted attempt with the LOWEST 6ng-bracket %bias (Section\nB's B3/B_QUANT_PASS evidence) instead of the earliest date.\nA Negative Control's own genuinely clean result (no peak on\nEITHER analyte, i.e. both C_NEGATIVE) is trusted as the best\npossible outcome outright, rather than an unranked unknown --\nsince a clean result and a small-but-nonzero 6ng bias are not\notherwise on a directly comparable numeric scale. NOT applied\nto real Samples: a Sample's own no-peak result is not\nobviously a BETTER outcome than a low-bias detection the way\na clean NC result is, so Samples still fall through to the\ndate-based tie-break unchanged. See ASTRA/doe/CONTEXT.md and\nGCMSQuantitation/CONTEXT.md, \"Prefer Lowest QC Bracket Error\non Reanalysis\" session, for full detail."];

    NOTE10 [label="Full status audit, 2026-09-08: every node/edge in Sections\nA-D checked directly against the live InjectionAcceptance.R\n(not assumed from memory or from this chart's own prior\nannotations). Two genuine, pre-existing chart/code mismatches\nfound and fixed:\n(1) Section A's blank evaluation was ALREADY a 3-tier\n    classification in the code (Contaminated/Trace detected/\n    Clean, same Quantifiable/Trace/Negative SNR tiers used\n    everywhere else) -- this chart previously showed only a\n    binary detected/not-detected split, missing the Trace-\n    detected case entirely.\n(2) Section C's C3 (bracketing-blank check) previously showed\n    a binary clean/flagged split -- missing the Trace-detected\n    blank case, which the code treats as a caveat (like a WARN),\n    not a hard fail, distinct from a fully Contaminated blank.\nBoth are now corrected to match the live code exactly. All\nother sections (B, D, and the rest of C) were confirmed already\naccurate; only wording referencing a since-removed function\nname (compute_analysis_accepted()) and a since-removed '0.2ng\noverride' mechanism (D4) needed updating, not the underlying\nlogic itself."];

    KEY -> NOTE1 -> NOTE2 -> NOTE3 -> NOTE3B -> NOTE3C -> NOTE4 -> NOTE5 -> NOTE6 -> NOTE7 -> NOTE8 -> NOTE9 -> NOTE10 [style=invis];
  }
}
