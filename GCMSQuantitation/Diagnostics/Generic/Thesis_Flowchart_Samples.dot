digraph Thesis_Samples {
  rankdir=TB;
  fontname="Georgia";
  fontsize=14;
  labelloc="t";
  label="GC-MS Sample & Negative Control Classification\n(evaluated independently for PETN and RDX)";
  bgcolor="white";
  splines=ortho;
  nodesep=0.7;
  ranksep=0.7;
  concentrate=false;
  node [fontname="Georgia", fontsize=11, style="filled,rounded", shape=box, margin="0.14,0.08", color="#555555", fillcolor="#f2f2f2"];
  edge [fontname="Georgia", fontsize=10, color="#333333", arrowsize=0.7, labelfontsize=10];

  s1 [label="Sample / NC\ninjection"];
  s2 [label="Internal standard\nvalid?", shape=diamond, fillcolor="#eef2f7"];
  s3 [label="Peak present?", shape=diamond, fillcolor="#eef2f7"];
  s4 [label="Bracketing blanks\nclean?", shape=diamond, fillcolor="#eef2f7"];
  s5 [label="SNR\nclassification", shape=diamond, fillcolor="#eef2f7"];
  s6 [label="6 ng bracket\nQCs pass?", shape=diamond, fillcolor="#eef2f7"];
  s7t [label="0.2 ng bracket\nQCs pass?", shape=diamond, fillcolor="#eef2f7"];
  s7n [label="0.2 ng bracket\nQCs pass?", shape=diamond, fillcolor="#eef2f7"];

  s_quant [label="Quantified", fillcolor="#e6f4ea"];
  s_trace [label="Trace detected\n(qualitative)", fillcolor="#fff6e0"];
  s_neg [label="Negative", fillcolor="#e6f4ea"];
  s_fail [label="Reanalyse", fillcolor="#fdeaea"];

  { rank=same; s7n; s7t; s6; }
  { rank=same; s_neg; s_trace; s_fail; s_quant; }

  s1 -> s2;
  s2 -> s_fail [xlabel="  N  "];
  s2 -> s3 [xlabel="  Y  "];
  s3 -> s4 [xlabel="  Y  "];
  s3 -> s7n [xlabel="  N  "];
  s4 -> s_fail [xlabel="  N  "];
  s4 -> s5 [xlabel="  Y  "];
  s5 -> s7n [xlabel="  < 3  "];
  s5 -> s7t [xlabel="  3-10  "];
  s5 -> s6 [xlabel="  >= 10  "];
  s6 -> s_quant [xlabel="  Y  "];
  s6 -> s_fail [xlabel="  N  "];
  s7t -> s_trace [xlabel="  Y  "];
  s7t -> s_fail [xlabel="  N  "];
  s7n -> s_neg [xlabel="  Y  "];
  s7n -> s_fail [xlabel="  N  "];

  subgraph cluster_key {
    label=""; style="invis";
    key [shape=plaintext, fontsize=9.5, label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
        <TR><TD BGCOLOR="#eef2f7">  </TD><TD ALIGN="LEFT">Decision</TD>
            <TD BGCOLOR="#e6f4ea">  </TD><TD ALIGN="LEFT">Accepted</TD></TR>
        <TR><TD BGCOLOR="#fff6e0">  </TD><TD ALIGN="LEFT">Flagged</TD>
            <TD BGCOLOR="#fdeaea">  </TD><TD ALIGN="LEFT">Failed</TD></TR>
      </TABLE>
    >];
  }
}
