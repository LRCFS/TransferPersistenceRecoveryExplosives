digraph Thesis_QC {
  rankdir=TB;
  fontname="Georgia";
  fontsize=14;
  labelloc="t";
  label="GC-MS QC Standard Evaluation";
  bgcolor="white";
  splines=ortho;
  nodesep=0.6;
  ranksep=0.6;
  concentrate=false;
  node [fontname="Georgia", fontsize=11, style="filled,rounded", shape=box, margin="0.14,0.08", color="#555555", fillcolor="#f2f2f2"];
  edge [fontname="Georgia", fontsize=10, color="#333333", arrowsize=0.7, labelfontsize=10];

  q1 [label="QC injection"];
  q2 [label="Concentration\nlevel?", shape=diamond, fillcolor="#eef2f7"];
  q3 [label="SNR >= 3?", shape=diamond, fillcolor="#eef2f7"];
  q4 [label="Bias <= 20%?", shape=diamond, fillcolor="#eef2f7"];
  q_sp [label="Sensitivity\nPASS", fillcolor="#e6f4ea"];
  q_sf [label="Sensitivity\nFAIL", fillcolor="#fdeaea"];
  q_qp [label="Quantitation\nPASS", fillcolor="#e6f4ea"];
  q_qf [label="Quantitation\nFAIL", fillcolor="#fdeaea"];

  q1 -> q2;
  q2 -> q3 [xlabel="  0.2 ng  "];
  q2 -> q4 [xlabel="  6 ng  "];
  q3 -> q_sp [xlabel="  Y  "];
  q3 -> q_sf [xlabel="  N  "];
  q4 -> q_qp [xlabel="  Y  "];
  q4 -> q_qf [xlabel="  N  "];

  subgraph cluster_key {
    label=""; style="invis";
    key [shape=plaintext, fontsize=9.5, label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
        <TR><TD BGCOLOR="#eef2f7">  </TD><TD ALIGN="LEFT">Decision</TD>
            <TD BGCOLOR="#e6f4ea">  </TD><TD ALIGN="LEFT">Accepted</TD></TR>
        <TR><TD BGCOLOR="#fdeaea">  </TD><TD ALIGN="LEFT">Failed</TD>
            <TD></TD><TD></TD></TR>
      </TABLE>
    >];
  }
}
